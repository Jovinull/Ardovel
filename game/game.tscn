[gd_scene format=3]

[ext_resource type="Script" path="res://game/game.gd" id="1_game"]
[ext_resource type="Theme" path="res://ui/theme.tres" id="2_theme"]
[ext_resource type="PackedScene" path="res://ui/hud/hud.tscn" id="3_hud"]
[ext_resource type="PackedScene" path="res://ui/death_screen/death_screen.tscn" id="4_death"]
[ext_resource type="PackedScene" path="res://ui/title/title_screen.tscn" id="5_title"]
[ext_resource type="PackedScene" path="res://ui/pause/pause_screen.tscn" id="6_pause"]
[ext_resource type="PackedScene" path="res://ui/hero_menu/hero_menu.tscn" id="7_equipment"]

[node name="Game" type="Node"]
script = ExtResource("1_game")

[node name="HUD" parent="." instance=ExtResource("3_hud")]

[node name="DeathScreen" parent="." instance=ExtResource("4_death")]

[node name="Fader" type="CanvasLayer" parent="."]
layer = 15

[node name="Fade" type="ColorRect" parent="Fader"]
unique_name_in_owner = true
modulate = Color(1, 1, 1, 0)
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(0.0784314, 0.105882, 0.105882, 1)

[node name="Interlude" type="Label" parent="Fader/Fade"]
unique_name_in_owner = true
visible = false
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 24.0
offset_right = -24.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2_theme")
theme_override_colors/font_color = Color(0.94902, 0.917647, 0.945098, 1)
horizontal_alignment = 1
vertical_alignment = 1
autowrap_mode = 3

[node name="TitleScreen" parent="." instance=ExtResource("5_title")]

[node name="Music" type="AudioStreamPlayer" parent="."]
volume_db = -8.0

[node name="PauseScreen" parent="." instance=ExtResource("6_pause")]

[node name="HeroMenu" parent="." instance=ExtResource("7_equipment")]
