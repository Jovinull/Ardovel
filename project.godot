[internationalization]

locale/translations=PackedStringArray("res://locale/text.pt_BR.translation", "res://locale/text.en.translation")
locale/fallback="pt_BR"

[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="player"
2d_physics/layer_3="enemies"
2d_physics/layer_4="player_hurtbox"
2d_physics/layer_5="enemy_hurtbox"
2d_physics/layer_6="interactables"
2d_physics/layer_7="animals"

[navigation]

world/map_use_async_iterations=false
world/region_use_async_iterations=false

[physics]

common/physics_interpolation=true

[rendering]

textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.0784314, 0.105882, 0.105882, 1)
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
